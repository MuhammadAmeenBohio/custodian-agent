# Langfuse (WBS 4.2, observe profile, off unless started): docker compose --profile observe up -d
# UI at http://127.0.0.1:${LANGFUSE_PORT}. Generate every secret yourself (python -c "import secrets; print(secrets.token_hex(32))");
# these are fake placeholders. The names below are NOT the SDK's (LANGFUSE_BASE_URL, ...): the backend container maps them,
# so that local pytest and uvicorn never switch tracing on by accident.
# Traces contain invoice text: synthetic data only until PII masking (WBS 3.1).
# LANGFUSE_PORT=13001
# LANGFUSE_NEXTAUTH_SECRET=changeme
# LANGFUSE_SALT=changeme
# LANGFUSE_ENCRYPTION_KEY=changeme          # 64 hex characters
# LANGFUSE_DB_PASSWORD=changeme
# LANGFUSE_CLICKHOUSE_PASSWORD=changeme
# LANGFUSE_REDIS_AUTH=changeme
# LANGFUSE_MINIO_PASSWORD=changeme
# LANGFUSE_INIT_USER_EMAIL=admin@custodian.local
# LANGFUSE_INIT_USER_PASSWORD=changeme
# LANGFUSE_INIT_PROJECT_PUBLIC_KEY=pk-lf-changeme
# LANGFUSE_INIT_PROJECT_SECRET_KEY=sk-lf-changeme
# LANGFUSE_INTERNAL_URL=http://langfuse-web:3000   # set this last: it is what switches tracing on in the backend container
